{
  "expo": {
    "name": "Hollow Brick Accounting",
    "slug": "my-business-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mybusinessapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.navanee9943.mybusinessapp",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "WAKE_LOCK",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6C5CE7",
          "sounds": []
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Hollow Brick Accounting to access your contacts to import customer contact details."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Hollow Brick Accounting to access your photos to save invoice receipts.",
          "savePhotosPermission": "Allow Hollow Brick Accounting to save invoice PDFs and receipt images to your device storage.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ec75836-145a-4962-8cca-89fbd8060360"
      }
    }
  }
}
